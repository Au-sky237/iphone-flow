# Optional configuration only. Copy to .env; never commit a filled .env.
# A signed, installed WebDriverAgent and Windows/USB setup are required.

WDA_BUNDLE_ID=
GO_IOS_AGENT_PORT=28100
VIEWER_PORT=8770
WDA_PORT=8100
MJPEG_PORT=9100
SEND_APPROVAL=always

# Leave blank for one phone and the default .state directory.
SIDETAP_UDID=
SIDETAP_STATE_DIR=

# Unlock the phone manually. Do not record unlock sequences.
PHONE_PASSCODE=

# Default 0 avoids background front-app polling.
VIEWER_PHONE_POLL_SECONDS=0
